{
  "name": "calendar-typespec",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsp compile .",
    "check": "tsp compile . --warn-as-error",
    "format": "tsp format \"**/*.tsp\"",
    "mock": "prism mock --host 0.0.0.0 --port 4010 ../openapi.yaml"
  },
  "dependencies": {
    "@typespec/compiler": "1.12.0",
    "@typespec/http": "1.12.0",
    "@typespec/openapi3": "1.12.0",
    "@typespec/rest": "0.82.0"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "5.14.2"
  }
}
